    {
      "id": "CTdAEgwX0M9bZm_DAwLdi",
      "type": "text",
      "x": 244.61578369140625,
      "y": -59.5172119140625,
      "width": 605.5392456054688,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
