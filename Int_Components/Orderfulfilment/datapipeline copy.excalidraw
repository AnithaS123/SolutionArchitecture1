      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1743246564,
      "version": 183,
      "versionNonce": 2046439780,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766140616724,
      "link": null,
      "locked": false,
      "text": "1. Data plane spans Raw → Curated\n2. Index plane bridges Curated → Consumption(opional)\n3. Retrival plane, 4. Generation plane --> both lives in consumption",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Data plane spans Raw → Curated\n2. Index plane bridges Curated → Consumption(opional)\n3. Retrival plane, 4. Generation plane --> both lives in consumption",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "QD_DjiQzZKs3wyyW2iXay",
      "type": "text",
      "x": 292.886474609375,
      "y": 782.6932678222656,
      "width": 757.0989379882812,
      "height": 459,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 576766820,
      "version": 182,
      "versionNonce": 1252514916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766144290500,
      "link": null,
      "locked": false,
      "text": "ADLS Gen2: raw/, curated/, (optional) consumption/.  --> Microsoft fabric -- > Muthu\n \nPurview: classification + catalog + lineage + certification --> Anitha\n\nADF/Synapse Pipelines: orchestration\n\nDatabricks/Synapse Spark/Fabric: sanitization gate + chunking.  -- > Anitha & Muthu\n\nAzure AI Search: hybrid retrieval (keyword+vector).  --> Anitha and Muthu\n\nContainer Apps + APIM: retrieval firewall + orchestration API  --> Muthu\n\nAzure OpenAI: embeddings + chat completion. --> sachit\n\nKey Vault + Managed Identity: credentials posture.  --> Muthu\n\nAzure Monitor + Sentinel: audit + detection    --> Anitha/Muthu",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ADLS Gen2: raw/, curated/, (optional) consumption/.  --> Microsoft fabric -- > Muthu\n \nPurview: classification + catalog + lineage + certification --> Anitha\n\nADF/Synapse Pipelines: orchestration\n\nDatabricks/Synapse Spark/Fabric: sanitization gate + chunking.  -- > Anitha & Muthu\n\nAzure AI Search: hybrid retrieval (keyword+vector).  --> Anitha and Muthu\n\nContainer Apps + APIM: retrieval firewall + orchestration API  --> Muthu\n\nAzure OpenAI: embeddings + chat completion. --> sachit\n\nKey Vault + Managed Identity: credentials posture.  --> Muthu\n\nAzure Monitor + Sentinel: audit + detection    --> Anitha/Muthu",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "fGh3gdWdpFALfiacmG5GN",
      "type": "text",
      "x": 333.73273371985454,
